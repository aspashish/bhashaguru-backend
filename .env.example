# ==============================================================================
# BHASHAGURU — PRODUCTION AND ENVIRONMENT CONFIGURATION GUIDE
# ==============================================================================

# 1. AI API Key Configuration (Backend Server)
# Add this environment variable in your Render dashboard (Settings -> Environment Variables).
# This key is kept securely on the server and is NEVER exposed to the Android client.
AI_API_KEY = *****
# Note: GEMINI_API_KEY is also accepted as a compatible alias for AI Studio:
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# 2. Production Render Backend URL (Android Client & Web App)
# Replace the placeholder with your deployed Render backend web service URL.
# Example: https://bhashaguru-api.onrender.com
RENDER_BACKEND_URL = *****
VITE_RENDER_BACKEND_URL="https://bhashaguru-backend.onrender.com"

# 3. Server Runtime Port & Environment (Render sets PORT automatically)
PORT=3000
NODE_ENV=production

# 4. Optional Persistent Database / Storage Directory on Render
# If attaching a Render Persistent Disk, set this path (e.g. /var/data/bhashaguru):
STORAGE_DIR=".data/students"
